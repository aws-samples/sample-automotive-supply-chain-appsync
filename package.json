{
  "name": "gmra",
  "version": "0.0.1",
  "bin": {
    "gmra": "bin/gmra.js"
  },
  "scripts": {
    "build": "npm run build-appsync && npx tsc",
    "build-appsync": "tsx ./lib/helpers/build-appsync.ts",
    "test": "jest --config jest.config.js",
    "watch": "npx tsc -w",
    "codegen": "graphql-codegen",
    "create": "node ./cli/magic.js config",
    "config": "node ./cli/magic.js config",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "npx prettier --ignore-path .gitignore --write \"**/*.+(js|ts|jsx|tsx|json|css)\"",
    "deploy": "npm run format && npx cdk deploy"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^4.1.3",
    "@jest/globals": "29.7.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/country-list": "2.1.4",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "aws-cdk": "^2.1022.0",
    "eslint": "9.0.0",
    "glob": "^11.0.0",
    "graphql": "^16.11.0",
    "jest": "29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-appsync/eslint-plugin": "^2.0.0",
    "@aws-appsync/utils": "^1.9.0",
    "@aws-lambda-powertools/batch": "^2.26.0",
    "@aws-lambda-powertools/logger": "^2.26.1",
    "@aws-sdk/client-appsync": "^3.883.0",
    "@aws-sdk/util-dynamodb": "^3.883.0",
    "@cdklabs/generative-ai-cdk-constructs": "^0.1.309",
    "aws-cdk-lib": "^2.216.0",
    "cdk-nag": "^2.37.35",
    "commander": "^14.0.1",
    "constructs": "^10.3.0",
    "country-list": "2.3.0",
    "enquirer": "2.4.1",
    "moment-timezone": "^0.6.0",
    "source-map-support": "0.5.21"
  },
  "overrides": {
    "eslint": "9.0.0",
    "esbuild": "^0.25.0"
  }
}
